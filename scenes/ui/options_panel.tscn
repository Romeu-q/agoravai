[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/options_panel.gd" id="1_options"]
[ext_resource type="Script" path="res://scripts/ui/neon_button.gd" id="2_button"]
[ext_resource type="Texture2D" path="res://assets/UI/slider_grabber.png" id="3_grabber"]

[sub_resource type="StyleBoxFlat" id="StyleBox_track"]
content_margin_top = 2.0
content_margin_bottom = 2.0
bg_color = Color(0.75, 0.96, 0.88, 0.25)

[sub_resource type="StyleBoxFlat" id="StyleBox_fill"]
content_margin_top = 2.0
content_margin_bottom = 2.0
bg_color = Color(0.3, 1.4, 0.1, 1)

[sub_resource type="StyleBoxEmpty" id="StyleBox_empty"]

[node name="Options" type="VBoxContainer"]
offset_right = 600.0
offset_bottom = 225.0
theme_override_constants/separation = 6
alignment = 1
script = ExtResource("1_options")

[node name="Music" type="HBoxContainer" parent="."]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
alignment = 1

[node name="Name" type="Label" parent="Music"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "MUSICA"
horizontal_alignment = 2

[node name="Slider" type="HSlider" parent="Music"]
texture_filter = 1
custom_minimum_size = Vector2(220, 24)
layout_mode = 2
size_flags_vertical = 4
theme_override_icons/grabber = ExtResource("3_grabber")
theme_override_icons/grabber_highlight = ExtResource("3_grabber")
theme_override_styles/slider = SubResource("StyleBox_track")
theme_override_styles/grabber_area = SubResource("StyleBox_fill")
theme_override_styles/grabber_area_highlight = SubResource("StyleBox_fill")
theme_override_styles/focus = SubResource("StyleBox_empty")
max_value = 1.0
step = 0.1
value = 0.8

[node name="Value" type="Label" parent="Music"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "80%"

[node name="Sfx" type="HBoxContainer" parent="."]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
alignment = 1

[node name="Name" type="Label" parent="Sfx"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "EFEITOS"
horizontal_alignment = 2

[node name="Slider" type="HSlider" parent="Sfx"]
texture_filter = 1
custom_minimum_size = Vector2(220, 24)
layout_mode = 2
size_flags_vertical = 4
theme_override_icons/grabber = ExtResource("3_grabber")
theme_override_icons/grabber_highlight = ExtResource("3_grabber")
theme_override_styles/slider = SubResource("StyleBox_track")
theme_override_styles/grabber_area = SubResource("StyleBox_fill")
theme_override_styles/grabber_area_highlight = SubResource("StyleBox_fill")
theme_override_styles/focus = SubResource("StyleBox_empty")
max_value = 1.0
step = 0.1
value = 1.0

[node name="Value" type="Label" parent="Sfx"]
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "100%"

[node name="Shake" type="Button" parent="."]
